# Copy to .env, or let bin/corewatch-demo create it with random passwords.
# Passwords are used in connection strings: letters and digits only.

# Which databases the demo starts and monitors: db2, informix or db2,informix.
COMPOSE_PROFILES=db2
COREWATCH_ENGINES=db2

DB2_PASSWORD=change-me-before-use
INFORMIX_PASSWORD=change-me-before-use
COREWATCH_INFORMIX_PASSWORD=change-me-before-use
GRAFANA_ADMIN_PASSWORD=change-me-too

# Set to off to stop the demo transaction generator.
DEMO_TRAFFIC=on
