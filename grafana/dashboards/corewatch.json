      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(db2_deadlocks_total{database=~\"$database\"}[15m])",
          "legendFormat": "{{database}} deadlocks",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(db2_lock_timeouts_total{database=~\"$database\"}[15m])",
          "legendFormat": "{{database}} timeouts",
          "refId": "B"
