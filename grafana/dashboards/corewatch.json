    {
      "id": 13,
      "title": "Buffer pool hit ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "1 - sum by (database) (rate(db2_bufferpool_physical_reads_total{database=~\"$database\"}[5m])) / sum by (database) (rate(db2_bufferpool_logical_reads_total{database=~\"$database\"}[5m]))",
          "legendFormat": "{{database}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
