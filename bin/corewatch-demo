#!/bin/sh
# corewatch-demo: start, stop and exercise the corewatch Compose demo.
#
#   bin/corewatch-demo up [db2|informix|both]   start (asks which database if omitted)
#   bin/corewatch-demo status                   containers and monitoring targets
#   bin/corewatch-demo scenario <name> <engine> trigger a real alert on purpose
#   bin/corewatch-demo backup informix          record a level-0 archive (ontape)
#   bin/corewatch-demo logs [service]           follow logs
#   bin/corewatch-demo down [--volumes]         stop everything (--volumes also deletes data)
#
# The selection is saved in .env as COMPOSE_PROFILES (which containers run) and
# COREWATCH_ENGINES (which targets the exporter monitors), so a stopped database
# is never reported as down, and plain "docker compose up -d" repeats the choice.
#
# Plain POSIX sh: runs with the /bin/sh on macOS and Linux.

set -eu

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"
ENV_FILE="$ROOT/.env"
EXPORTER_URL="http://127.0.0.1:9953/metrics"

if [ -t 1 ]; then
    B=$(printf '\033[1m'); G=$(printf '\033[32m'); Y=$(printf '\033[33m'); R=$(printf '\033[31m'); N=$(printf '\033[0m')
else
    B=; G=; Y=; R=; N=
fi
say()  { printf '%s\n' "$*"; }
info() { printf '%s==>%s %s\n' "$B" "$N" "$*"; }
ok()   { printf '%s ok %s %s\n' "$G" "$N" "$*"; }
warn() { printf '%swarn%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%sfail%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; }

# -- prerequisites -------------------------------------------------------------

need_docker() {
    command -v docker >/dev/null 2>&1 || die "docker is not installed"
    docker compose version >/dev/null 2>&1 || die "docker compose (v2) is not available"
    docker info >/dev/null 2>&1 || die "Docker is not running. Start Docker Desktop and try again."
}

# -- .env handling -------------------------------------------------------------

env_get() { # key -> value ('' if missing)
    [ -f "$ENV_FILE" ] || return 0
    awk -F= -v k="$1" '$1 == k { sub(/^[^=]*=/, ""); v = $0 } END { if (v != "") print v }' "$ENV_FILE"
}

env_set() { # key value: replace the line or append it
    tmp="$ENV_FILE.tmp.$$"
    if [ -f "$ENV_FILE" ] && grep -q "^$1=" "$ENV_FILE"; then
        awk -F= -v k="$1" -v v="$2" '$1 == k { print k "=" v; next } { print }' "$ENV_FILE" >"$tmp"
    else
        { [ -f "$ENV_FILE" ] && cat "$ENV_FILE"; printf '%s=%s\n' "$1" "$2"; } >"$tmp"
    fi
    mv "$tmp" "$ENV_FILE"
    chmod 600 "$ENV_FILE"
}

random_password() { # letters and digits only: passwords go into connection strings
    LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom 2>/dev/null | dd bs=1 count=20 2>/dev/null
}

ensure_env() {
    if [ ! -f "$ENV_FILE" ]; then
        info "creating .env with random passwords"
        : >"$ENV_FILE"
        chmod 600 "$ENV_FILE"
    fi
    for key in DB2_PASSWORD INFORMIX_PASSWORD COREWATCH_INFORMIX_PASSWORD GRAFANA_ADMIN_PASSWORD; do
        value=$(env_get "$key")
        case "$value" in
            "" | change-me*)
                env_set "$key" "$(random_password)"
                say "     generated $key"
                ;;
        esac
    done
    [ -n "$(env_get DEMO_TRAFFIC)" ] || env_set DEMO_TRAFFIC on
}

# -- selection -----------------------------------------------------------------

profiles_for() { # db2 | informix | both -> db2,informix
    case "$1" in
        db2) echo db2 ;;
        informix | ifx) echo informix ;;
        both | all | db2,informix | informix,db2) echo db2,informix ;;
        *) return 1 ;;
    esac
}

ask_selection() { # menu on stderr, answer on stdout
    current=$(env_get COMPOSE_PROFILES)
    case "$current" in db2,informix | informix,db2) def=3 ;; informix) def=2 ;; *) def=1 ;; esac
    {
        say ""
        say "${B}Which database should the demo run?${N}"
        say "  1) Db2 12.1 Community Edition     (about 3-5 minutes on first start)"
        say "  2) Informix 15 Developer Edition  (about 1 minute on first start)"
        say "  3) Both"
        printf 'Choice [%s]: ' "$def"
    } >&2
    read -r answer || answer=
    case "${answer:-$def}" in
        1) echo db2 ;;
        2) echo informix ;;
        3) echo db2,informix ;;
        *) echo "" ;;
    esac
}

selected() { env_get COMPOSE_PROFILES; }
has_engine() { case ",$(selected)," in *",$1,"*) return 0 ;; *) return 1 ;; esac; }

# -- readiness -----------------------------------------------------------------

target_up() { # engine -> 0 if every target of that engine reports *_up 1
    metrics=$(curl -fs --max-time 5 "$EXPORTER_URL" 2>/dev/null) || return 1
    lines=$(printf '%s\n' "$metrics" | grep "^$1_up{" || true)
    [ -n "$lines" ] || return 1
    ! printf '%s\n' "$lines" | grep -q ' 0\.0$'
}

wait_for() { # engine timeout_seconds
    engine=$1; limit=$2; waited=0
    printf '     waiting for %s ' "$engine"
    while ! target_up "$engine"; do
        if [ "$waited" -ge "$limit" ]; then
            printf '\n'
            warn "$engine is not answering after ${limit}s. Check: bin/corewatch-demo logs $engine"
            return 1
        fi
        printf '.'
        sleep 10
        waited=$((waited + 10))
    done
    printf ' %sready%s (%ss)\n' "$G" "$N" "$waited"
}

# -- commands ------------------------------------------------------------------

cmd_up() {
    need_docker
    ensure_env
    if [ $# -gt 0 ]; then
        choice=$(profiles_for "$1") || die "unknown choice '$1': use db2, informix or both"
    elif [ -t 0 ]; then
        choice=$(ask_selection)
        [ -n "$choice" ] || die "please answer 1, 2 or 3"
    else
        choice=$(env_get COMPOSE_PROFILES)
        choice=${choice:-db2}
    fi
    env_set COMPOSE_PROFILES "$choice"
    env_set COREWATCH_ENGINES "$choice"
    info "starting corewatch with: $choice"

    # Stop a database that was running before but is no longer selected.
    for engine in db2 informix; do
        if ! has_engine "$engine" && [ -n "$(docker compose --profile "$engine" ps -q "$engine" 2>/dev/null)" ]; then
            info "stopping $engine (not selected)"
            docker compose --profile "$engine" stop "$engine" >/dev/null
        fi
    done

    docker compose up -d --build --remove-orphans
    info "waiting for the exporter to see the databases"
    rc=0
    has_engine informix && { wait_for informix 300 || rc=1; }
    has_engine db2 && { wait_for db2 600 || rc=1; }
    show_urls
    return $rc
}

show_urls() {
    say ""
    say "${B}corewatch is running${N} ($(selected))"
    say "  Grafana        http://localhost:3000   (admin / GRAFANA_ADMIN_PASSWORD in .env)"
    say "  Prometheus     http://localhost:9090/alerts"
    say "  Alertmanager   http://localhost:9093"
    say "  Exporter       $EXPORTER_URL"
    say ""
    say "Try a failure:   bin/corewatch-demo scenario long-txn informix"
}

cmd_status() {
    need_docker
    info "containers ($(selected))"
    docker compose ps --format 'table {{.Service}}\t{{.State}}\t{{.Status}}'
    say ""
    info "monitoring targets"
    metrics=$(curl -fs --max-time 5 "$EXPORTER_URL" 2>/dev/null) || { warn "exporter not reachable at $EXPORTER_URL"; return 1; }
    printf '%s\n' "$metrics" | grep -E '^(db2|informix)_up\{' | sed -E \
        -e 's/^(db2|informix)_up\{.*(database|server)="([^"]*)".*\} 1\.0$/  \1 \3: up/' \
        -e 's/^(db2|informix)_up\{.*(database|server)="([^"]*)".*\} 0\.0$/  \1 \3: DOWN/'
    failed=$(printf '%s\n' "$metrics" | grep -E '_query_success\{.*\} 0\.0$' || true)
    if [ -n "$failed" ]; then
        warn "monitoring queries failing:"
        printf '%s\n' "$failed" | sed -E 's/.*query="([^"]*)".*/  \1/' >&2
    fi
    firing=$(curl -fs --max-time 5 'http://127.0.0.1:9090/api/v1/alerts' 2>/dev/null |
        grep -o '"alertname":"[^"]*"[^}]*"state":"firing"' | sed -E 's/"alertname":"([^"]*)".*/\1/' | sort -u || true)
    say ""
    info "firing alerts"
    if [ -n "$firing" ]; then printf '  %s\n' $firing; else say "  none"; fi
}

cmd_scenario() {
    [ $# -ge 2 ] || die "usage: bin/corewatch-demo scenario <lock-wait|long-txn> <db2|informix> [seconds]"
    name=$1; engine=$2; seconds=${3:-0}
    case "$name" in lock-wait | long-txn) ;; *) die "scenario must be lock-wait or long-txn" ;; esac
    case "$engine" in db2 | informix) ;; *) die "engine must be db2 or informix" ;; esac
    has_engine "$engine" || die "$engine is not running. Start it with: bin/corewatch-demo up $engine (or both)"
    need_docker
    case "$name/$engine" in
        long-txn/informix) say "Opens a transaction and fills logical logs until it spans half of them." \
            "InformixLongTransaction fires about 2 minutes later." ;;
        long-txn/db2) say "Leaves a unit of work open. Db2LongTransaction fires after about 35 minutes." ;;
        lock-wait/*) say "One session holds a row lock while six queue behind it. The lock-wait alert fires after 5 minutes." ;;
    esac
    say "Watch: Grafana (http://localhost:3000) and http://localhost:9090/alerts. Ctrl-C ends it early and rolls back."
    docker compose run --rm demo-workload scenario "$name" --engine "$engine" --seconds "$seconds"
}

cmd_backup() {
    [ "${1:-}" = informix ] || die "usage: bin/corewatch-demo backup informix"
    has_engine informix || die "informix is not running"
    need_docker
    info "recording a level-0 archive (ontape -s -L 0; the demo TAPEDEV is /dev/null)"
    docker compose exec -T informix bash -lc 'ontape -s -L 0 -t /dev/null </dev/null' >/dev/null
    ok "done. 'Since last level-0 backup' resets on the next scrape."
}

cmd_logs() {
    need_docker
    docker compose logs -f --tail 100 "$@"
}

cmd_down() {
    need_docker
    if [ "${1:-}" = "--volumes" ]; then
        warn "this deletes the Db2 and Informix data volumes"
        docker compose --profile db2 --profile informix down --volumes --remove-orphans
    else
        docker compose --profile db2 --profile informix down --remove-orphans
    fi
}

case "${1:-help}" in
    up) shift; cmd_up "$@" ;;
    status) cmd_status ;;
    scenario) shift; cmd_scenario "$@" ;;
    backup) shift; cmd_backup "$@" ;;
    logs) shift; cmd_logs "$@" ;;
    down) shift; cmd_down "$@" ;;
    urls) show_urls ;;
    -h | --help | help) usage ;;
    *) usage; exit 64 ;;
esac
